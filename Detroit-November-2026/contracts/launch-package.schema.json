{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic retail launch package v1",
  "description": "Shared local output boundary, not an implemented platform endpoint. Evidence pointers resolve against the manufacturer source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "synthetic", "generationMode", "productId", "retailerId", "listing", "brief", "handoff", "evidence", "review"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "synthetic": {"const": true},
    "generationMode": {"enum": ["deterministic-local-reference", "agent-draft"]},
    "productId": {"type": "string", "minLength": 1},
    "retailerId": {"const": "great-lakes-home"},
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "title", "brand", "category", "currency", "msrp", "gtin", "imageAssets", "warrantyTerms", "bullets", "specifications"],
      "properties": {
        "sku": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "brand": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "currency": {"const": "USD"},
        "msrp": {"type": "number", "minimum": 0},
        "gtin": {"type": ["string", "null"]},
        "imageAssets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "warrantyTerms": {"type": ["string", "null"]},
        "bullets": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "specifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nominalVoltageV", "batteryCapacityAh", "batteryCount", "maxSpeedRpm", "maxTorqueNm", "toolHolder", "massWithBatteryKg"],
          "properties": {
            "nominalVoltageV": {"type": "number", "minimum": 0},
            "batteryCapacityAh": {"type": "number", "minimum": 0},
            "batteryCount": {"type": "integer", "minimum": 1},
            "maxSpeedRpm": {"type": "number", "minimum": 0},
            "maxTorqueNm": {"type": "number", "minimum": 0},
            "toolHolder": {"type": "string", "minLength": 1},
            "massWithBatteryKg": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launchDate", "audience", "inBox", "knownGaps"],
      "properties": {
        "launchDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "audience": {"type": "string", "minLength": 1},
        "inBox": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "knownGaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "body"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "sourceId", "pointer"],
        "properties": {
          "field": {"type": "string", "pattern": "^/"},
          "sourceId": {"const": "manufacturer-products-v1"},
          "pointer": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "blockers"],
      "properties": {
        "status": {"const": "needs_review"},
        "approvedBy": {"const": null},
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "field", "message"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
